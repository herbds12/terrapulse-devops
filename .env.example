# =====================================================================
# Copie para ".env" e ajuste os valores:   cp .env.example .env
# O arquivo .env NAO deve ser versionado (esta no .gitignore).
# =====================================================================

# Ambiente ASP.NET Core usado no container local
ASPNETCORE_ENVIRONMENT=Docker

# Portas expostas no host
API_PORT=8080
DB_PORT=14333

# SQL Server (senha precisa ter 8+ caracteres, maiusculas, minusculas, numeros e simbolos)
DB_NAME=TerraPulseDb
DB_SA_PASSWORD=TerraPulse@2026#Db

# JWT (use uma chave longa e aleatoria, minimo 32 caracteres)
JWT_KEY=TROQUE_POR_UMA_CHAVE_SECRETA_LONGA_E_ALEATORIA_2026
JWT_ISSUER=TerraPulse.Api
JWT_AUDIENCE=TerraPulse.Client

# Versao exibida em /health (no pipeline e o SHA do commit)
APP_VERSION=local
